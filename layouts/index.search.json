{{- $pages := where .Site.RegularPages "Draft" false -}}
{{- $pages = where $pages "File.BaseFileName" "ne" "search" -}}
[{{ range $i, $p := $pages }}{{ if $i }},{{ end }}{{ dict "t" $p.Title "u" $p.RelPermalink "s" $p.Section "c" ($p.Params.category | default "") "d" ($p.Description | default ($p.Summary | plainify | truncate 150)) "k" (print $p.Title " " (replace $p.File.BaseFileName "-" " ") " " ($p.Params.category | default "") " " (delimit ($p.Params.tags | default slice) " ")) | jsonify }}{{ end }}]
